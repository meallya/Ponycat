{
  "name": "dynamic-island-win",
  "version": "1.1.0",
  "description": "Dynamic Island untuk Windows (Electron + React + Framer Motion)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env DEV=1 electron .\"",
    "demo": "cross-env ISLAND_DEMO_MEDIA=1 ISLAND_DEMO_NOTIFS=1 npm run dev",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@romanize/korean": "^0.1.3",
    "adhan": "^4.4.6",
    "framer-motion": "^14.6.0",
    "pdf-lib": "^1.17.1",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "transliteration": "^2.7.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "electron-builder": "^26.0.8"
  },
  "build": {
    "appId": "com.ponycat.notch",
    "productName": "Ponycat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/*.ps1"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PonycatSetup.${ext}",
      "shortcutName": "Ponycat",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
